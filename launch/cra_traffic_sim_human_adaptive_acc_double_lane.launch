<?xml version="1.0"?>
<launch>
    <arg name="pv_speed_profile" default="I85_ftp_sec_2.csv" />
    <arg name="dir" default="0"/>
    <arg name="use_preview" default="1"/>
    <arg name="sim_run" default="0"/>
    <arg name="site_map_0" default="CMI_outerloop_mach_e.csv"/>
    <arg name="site_map_1" default="CMI_outerloop_mach_e_wider_lane.csv"/>
    <arg name="scenario_file" default="$(find cra_traffic_sim)/config/double_lane_scenario.json"/>
    <arg name="side_lane_stationary_safety_buffer" default="2.0"/>
    <arg name="side_lane_change_duration" default="3.0"/>
    <!-- Lane-change control limits: rad/s, m/s^3, and meters. -->
    <arg name="max_steering_rate" default="1.0"/>
    <arg name="max_jerk" default="5.0"/>
    <arg name="min_lookahead_distance" default="15.0"/>

    <param name="runDirection" value="$(arg dir)"/>
    <param name="run_sim" value="$(arg sim_run)"/>
    <param name="map_0" value="$(arg site_map_0)"/>
    <param name="map_1" value="$(arg site_map_1)"/>
    <param name="spd_map" value="$(arg pv_speed_profile)"/>
    <param name="pv_states_dt" value="0.5"/>
    <param name="use_preview" value="$(arg use_preview)"/>
    <param name="side_lane_stationary_safety_buffer" value="$(arg side_lane_stationary_safety_buffer)"/>
    <param name="side_lane_change_duration" value="$(arg side_lane_change_duration)"/>
    <param name="max_steering_rate" value="$(arg max_steering_rate)"/>
    <param name="max_jerk" value="$(arg max_jerk)"/>
    <param name="min_lookahead_distance" value="$(arg min_lookahead_distance)"/>
    <param name="track_style" value="Rally"/>
    <node pkg="cra_traffic_sim" type="car_following_double_lane.py" name="CRA_Digital_Twin_Traffic" output="screen">
        <param name="scenario_file" value="$(arg scenario_file)"/>
    </node>
    <node pkg="joy" type="joy_node" name="joy_node" output="screen" />
    <group if="$(arg sim_run)">
        <node pkg="cra_traffic_sim" type="anl_sim.py" name="anl_sim" output="screen" />
    </group>

    <include file="$(find hololens_ros_communication)/launch/hololens_sender.launch" />
    <!-- <node pkg="low_level_bridge" name="bridge" type="bridge_KF_lanechange_MachE.py" output="screen"/> -->
</launch>
