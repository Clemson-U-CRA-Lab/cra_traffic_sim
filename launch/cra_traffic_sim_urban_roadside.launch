<?xml version="1.0"?>
<launch>
    <!-- Distances in meters; steering angle in radians. -->
    <arg name="vehicle_length" default="3.5"/>
    <arg name="wheelbase" default="3.5"/>
    <arg name="lookahead_distance" default="3.0"/>
    <arg name="max_steering_angle" default="0.5"/>
    <param name="map_1" value="CMI_outerloop_mach_e_wider_lane.csv"/>
    <param name="map_2" value="CMI_outerloop_mach_e.csv"/>
    <param name="spd_map_1" value="ITIC_Lane_Change_Modeling_StartLane.csv"/>
    <param name="spd_map_2" value="ITIC_Lane_Change_Modeling_EndLane.csv"/>
    <param name="track_style" value="Rally"/>
    <param name="num_vehicles" value="6"/>
    <param name="vehicle_length" value="$(arg vehicle_length)"/>
    <param name="wheelbase" value="$(arg wheelbase)"/>
    <param name="lookahead_distance" value="$(arg lookahead_distance)"/>
    <param name="max_steering_angle" value="$(arg max_steering_angle)"/>
    <node pkg="cra_traffic_sim" type="urban_roadside_scenario.py" name="CRA_urban_roadside_traffic_scene" output="screen"/>
</launch>